{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "baseUrl": ".",
    "paths": {
      "@carrierflow/contracts/*": [
        "packages/contracts/src/*"
      ],
      "@carrierflow/design-tokens/*": [
        "packages/design-tokens/src/*"
      ],
      "@carrierflow/routing-contract/*": [
        "packages/routing-contract/src/*"
      ]
    }
  },
  "exclude": [
    "blueprints/**",
    "node_modules/**",
    ".next/**"
  ]
}

